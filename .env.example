# Knox Suite Environment Variables
# Copy to .env file

# Anthropic API Key (required for AI analysis)
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Override model (default: claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional: Overall timeout in seconds (default: 300)
# KNOX_TIMEOUT=600

# Optional: Output directory (default: ./reports)
# KNOX_OUTPUT_DIR=./reports

# Optional: Verbose logging (default: false)
# KNOX_VERBOSE=true

# Optional: Disable AI analysis (default: false)
# KNOX_NO_AI=true

# Optional: Exit with error code if findings >= severity (critical, high, medium, low)
# KNOX_FAIL_ON=high